def translate_dna(dna):
    dna = dna.upper()

    codon_table = {
        "ATG": "Methionine",
        "TTT": "Phenylalanine",
        "TTC": "Phenylalanine",
        "TAA": "STOP",
        "TAG": "STOP",
        "TGA": "STOP"
    }

    protein = []

    for i in range(0, len(dna), 3):
        codon = dna[i:i+3]

        if len(codon) < 3:
            break

        if codon in codon_table:
            amino = codon_table[codon]
            protein.append(amino)

            if amino == "STOP":
                break

        else:
            protein.append("unknown")

    return protein

dna_input = input("Enter DNA sequence: ")
result = translate_dna(dna_input)
print("Protein sequence:", result)
